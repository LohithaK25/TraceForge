# Local demo settings. Copy to .env only when a component needs them.
SERVER_PORT=8080
VITE_API_BASE_URL=
POSTGRES_DB=traceforge
POSTGRES_USER=traceforge
POSTGRES_PASSWORD=replace-with-local-only-password
TRACEFORGE_TEST_DB_PASSWORD=traceforge-test-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-only-password
TRACEFORGE_TRACING_ENABLED=true
TRACEFORGE_DETECTION_INTERVAL_SECONDS=5
TRACEFORGE_ORDER_TERMINAL_LOOKUP_LIMIT=500

# Future investigation provider configuration. Leave blank to use the deterministic investigator.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
